{
  "id": "zoom_slow_push",
  "version": "1.0",
  "category": "camera",
  "label": "Slow push-in",
  "description": "Wolny push-in przed reveal lub ważnym momentem.",
  "platforms": ["youtube"],
  "trendTags": ["talking_head", "documentary"],
  "params": {
    "factor": { "type": "number", "min": 1.02, "max": 1.12, "default": 1.05 },
    "durationSec": { "type": "number", "min": 3, "max": 12, "default": 6 },
    "anchor": { "type": "enum", "values": ["face", "subject", "center"], "default": "face" },
    "easeSec": { "type": "number", "default": 1.0 }
  },
  "constraints": {
    "minGapFromSameTechniqueSec": 90,
    "maxPerOutputMinutes": 0.08,
    "requiresSpatialAnchor": true,
    "forbiddenOnSegmentRole": ["broll"],
    "requiresCreativityLevel": null
  },
  "whenToUse": "Budowanie napięcia przed ważnym punktem.",
  "whenToAvoid": "Szybkie tempo, shorts.",
  "syncHints": ["sentence_start", "topic_intro"]
}
