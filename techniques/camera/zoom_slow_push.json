{
  "id": "zoom_slow_push",
  "version": "1.0",
  "category": "camera",
  "label": "Slow push-in",
  "description": "Wolny push-in przed reveal lub ważnym momentem.",
  "platforms": [
    "youtube"
  ],
  "trendTags": [
    "talking_head",
    "documentary",
    "cinematic"
  ],
  "narrativeFunctions": [
    "tension",
    "intimacy",
    "reveal"
  ],
  "visualIntensity": "subtle",
  "params": {
    "factor": {
      "type": "number",
      "min": 1.02,
      "max": 1.15,
      "default": 1.05
    },
    "durationSec": {
      "type": "number",
      "min": 3,
      "max": 20,
      "default": 10
    },
    "anchor": {
      "type": "enum",
      "values": [
        "face",
        "subject",
        "center"
      ],
      "default": "face"
    },
    "easeSec": {
      "type": "number",
      "default": 1
    }
  },
  "constraints": {
    "minGapFromSameTechniqueSec": 90,
    "maxPerOutputMinutes": 0.08,
    "requiresSpatialAnchor": true,
    "forbiddenOnSegmentRole": [
      "broll"
    ],
    "requiresCreativityLevel": null
  },
  "whenToUse": "Powolne, prawie niezauważalne wejście w emocję przed revealem, decyzją lub niepokojącą puentą; zakończ dokładnie na cięciu.",
  "whenToAvoid": "Szybkie tempo, przypadkowy fragment bez narastania albo moment kończący się bez cięcia (widoczny reset skali).",
  "syncHints": [
    "sentence_start",
    "topic_intro"
  ],
  "renderSupport": "full"
}
