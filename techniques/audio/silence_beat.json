{
  "id": "silence_beat",
  "version": "1.0",
  "category": "audio",
  "label": "Silence beat",
  "description": "Krótka pauza dramatyczna przed lub po akcentie.",
  "platforms": [
    "youtube",
    "shorts"
  ],
  "trendTags": [
    "dramatic"
  ],
  "params": {
    "durationSec": {
      "type": "number",
      "min": 0.3,
      "max": 2,
      "default": 0.8
    }
  },
  "constraints": {
    "minGapFromSameTechniqueSec": 45,
    "maxPerOutputMinutes": 0.05,
    "requiresSpatialAnchor": false,
    "forbiddenOnSegmentRole": [],
    "requiresCreativityLevel": "bold"
  },
  "whenToUse": "Punchline, reveal, kontrast przed ważnym zdaniem.",
  "whenToAvoid": "Szybki montaż bez pauz narracyjnych.",
  "syncHints": [
    "pause",
    "punchline"
  ],
  "renderSupport": "audio_only"
}
