OPENAI_API_KEY=sk-...

# Bazowe poziomy modeli OpenAI
OPENAI_MODEL_NANO=gpt-5.4-nano
OPENAI_MODEL_MINI=gpt-5.4-mini
OPENAI_MODEL_FLAGSHIP=gpt-5.4

# Routing jakościowy: L1 nano, L2 mini, L3 flagship
# OPENAI_MODEL_SUMMARIZER_L1=gpt-5.4-nano
# OPENAI_MODEL_SUMMARIZER_L2=gpt-5.4-mini
# OPENAI_MODEL_SUMMARIZER_L3=gpt-5.4

# Globalne decyzje reżyserskie używają flagship; lokalne drafty i drill-down — mini
# OPENAI_MODEL_DIRECTOR=gpt-5.4
# OPENAI_MODEL_SUPER_DIRECTOR=gpt-5.4
# OPENAI_MODEL_SEGMENT_DIRECTOR=gpt-5.4-mini
# OPENAI_MODEL_DIRECTOR_DRILLDOWN=gpt-5.4-mini

# Review i naprawy: mini w pierwszym przebiegu, flagship od drugiej próby Fixera
# OPENAI_MODEL_CRITIC=gpt-5.4-mini
# OPENAI_MODEL_FIXER=gpt-5.4-mini
# OPENAI_MODEL_FIXER_ESCALATION=gpt-5.4
# OPENAI_MODEL_SAFETY_CLASSIFIER=gpt-5.4-mini

# OPENAI_MODEL_SFX_ENRICH=gpt-4o-mini-audio-preview
# OPENAI_MODEL_SFX_ENRICH_TEXT=gpt-5.4-nano

# --- Dzienne limity OpenAI (traffic shared) ---
# Darmowe pule: premium 250k/dzień (gpt-5.4, gpt-4o, …), mini 2.5M/dzień (gpt-5.4-mini/nano, gpt-4o-mini, …)
# OPENAI_QUOTA_TRACKING=1
# OPENAI_USAGE_DIR=output/.openai-usage
# OPENAI_QUOTA_TIMEZONE=UTC
# OPENAI_DAILY_PREMIUM_LIMIT=250000
# OPENAI_DAILY_MINI_LIMIT=2500000
# OPENAI_QUOTA_RESERVE_PERCENT=5
# OPENAI_QUOTA_RESERVATION_TTL_MINUTES=30
# OPENAI_MODEL_DOWNGRADE_ENABLED=1
# OPENAI_MODEL_DOWNGRADE_POLICY=balanced
# OPENAI_QUOTA_ON_EXHAUSTED=downgrade
# OPENAI_ROUTER_MAX_RETRIES=2
# OPENAI_ROUTER_MAX_DOWNGRADES=1
# OPENAI_USAGE_WARN_PERCENT=70,90,100
#
# Jednorazowy seed zużycia sprzed włączenia trackera:
# node scripts/seed-openai-daily-quota.js --premium 250000 --exhausted premium
# OPENAI_QUOTA_SEED_PREMIUM=250000
# OPENAI_QUOTA_SEED_MINI=0
# OPENAI_QUOTA_SEED_EXHAUSTED=premium
# OPENAI_QUOTA_SEED_NOTE=usage before quota tracking

# Profil awaryjny po wyczerpaniu puli premium (ręcznie, przed włączeniem routera):
# OPENAI_MODEL_SUMMARIZER_L3=gpt-5.4-mini
# OPENAI_MODEL_DIRECTOR=gpt-5.4-mini
# OPENAI_MODEL_SUPER_DIRECTOR=gpt-5.4-mini
# OPENAI_MODEL_FIXER_ESCALATION=gpt-5.4-mini

# OpenAI Whisper (transcribe step)
OPENAI_WHISPER_MODEL=whisper-1

# Opcjonalnie: ścieżki do ffmpeg
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Opcjonalnie: venv Pythona dla scene_detect / Qwen / Florence
# PYTHON_VENV=/path/to/venv
#
# Florence-2 (krok objects) jest WYMAGANY domyślnie — zainstaluj:
#   pip3 install -r python/requirements.txt
# Escape hatch bez detekcji: --no-objects lub --objects-stub

# TwelveLabs — domyślnie live gdy klucz ustawiony (stub: --twelvelabs-stub)
TWELVELABS_API_KEY=tlk_
TWELVELABS_INDEX_ID=6a47e322a050a53f8f63a3a6
# Krótkie klipy (<4s): GPT vision zamiast uploadu (pula mini)
# OPENAI_MODEL_TWELVELABS_SHORT=gpt-4o-mini
# TWELVELABS_MIN_DURATION_SEC=4
# Proxy przed uploadem (iPhone 4K) + chunking długich klipów
# TWELVELABS_PROXY_MAX_BYTES=188743680
# TWELVELABS_PROXY_HEIGHT=720
# TWELVELABS_CHUNK_DURATION_SEC=300
# TWELVELABS_MAX_SINGLE_DURATION_SEC=1200

# Globalny cache analizy per-clip między batchami (output/.cache/analysis).
# Ustaw DISABLE_GLOBAL_ANALYSIS_CACHE=1 aby wyłączyć (alternatywa: --no-global-cache).
# DISABLE_GLOBAL_ANALYSIS_CACHE=1

# Równoległość analizy per-clip (transcribe, audio, keyframes, twelvelabs)
# CLIP_CONCURRENCY=1
# AUDIO_CONCURRENCY=1   # librosa + PANNs per clip; >1 risks OOM on long iPhone clips

# Równoległość kroków GPU (vision, objects, face-detect)
# GPU_CONCURRENCY=1

# Downscale keyframes przed Qwen/Florence (unika OOM na 4K iPhone); max dłuższy bok w px
# VISION_MAX_SIDE=1280

# Timeout Python vision/objects per klip (ms); skaluje się z liczbą klatek
# VISION_TIMEOUT_PER_FRAME_MS=45000
# VISION_TIMEOUT_BASE_MS=300000
# VISION_TIMEOUT_MIN_MS=1800000

# Opt-in: przywraca stare wave scheduling (domyślnie wyłączone — sekwencyjnie krok po kroku)
# ANALYSIS_PARALLEL_CLIPS=1      # transcribe ∥ audio ∥ twelvelabs per klip
# ANALYSIS_PARALLEL_GPU_STEPS=1  # vision ∥ objects na tym samym klipie

# Równoległe wywołania segment directora (Super Director)
# SEGMENT_DIRECTOR_CONCURRENCY=3

# Review: domyślnie włącz --strict-review dla run/full (wymaga zatwierdzenia krytyka)

# Polityka LUT/korekcji koloru: off (domyślnie, iPhone SDR) | allow (włącz colorGrade z receptury)
# COLOR_GRADE_POLICY=off
# PIPELINE_STRICT_REVIEW=1

# Kling VIDEO 3.0 — AI video hooks (krok ai_video; domyślnie wyłączone)
# Kup API: https://kling.ai/dev/pricing (Trial ~$9.80)
# Klucz z https://kling.ai/dev/api-key (format api-key-kling-...)
# KLING_ACCESS_KEY=
# KLING_VIDEO_MODEL=kling-v3
# Jawny tryb placeholdera dla CI/dev; brak kluczy nie włącza stuba automatycznie.
# AI_VIDEO_STUB=1

# Cache (dwa niezależne poziomy):
# 1) Artefakty kroków — domyślnie pomijaj świeże pliki w output/.work/<batch>/; --force wymusza przelicz.
# 2) Odpowiedzi LLM — zawsze zapisywane w llm-cache/; domyślnie świeże API przy wykonaniu kroku.
#    Reuse tylko CLI: --reuse-llm-cache (nie ustawiaj LLM_REUSE_CACHE w env).
# Abstract L1 poison: --from-step abstract przebuduje bez --force (integrity gate).

# Audio enhancement (krok audio_enhancement po direct)
# Domyślnie DPDFNet — bez cichego fallbacku; przy failu powstaje 17-recovery-plan.json
# AUDIO_ENHANCEMENT_PROVIDER=dpdfnet
# Jawny fallback dev/CI: AUDIO_ENHANCEMENT_PROVIDER=ffmpeg lub AUDIO_ENHANCEMENT_STUB=1
# Legacy DeepFilterNet: AUDIO_ENHANCEMENT_PROVIDER=deepfilternet
# AUDIO_ENHANCEMENT_STUB=0
# AUDIO_ENHANCEMENT_REQUIRED=0
# AUDIO_ENHANCEMENT_MAX_CONCURRENCY=1
# DPDFNET_BIN=dpdfnet
# DPDFNET_MODEL=dpdfnet8_48khz_hr
# DPDFNET_ATTN_LIMIT_DB=12
# DEEPFILTERNET_BIN=deepFilter
# DEEPFILTERNET_MODEL_PATH=
# ARNNDN_MODEL_PATH=
# AUDIO_ENHANCEMENT_PAID_PROVIDER=
# AUDIO_ENHANCEMENT_API_BASE_URL=
# AUDIO_ENHANCEMENT_API_KEY=
# AUDIO_ENHANCEMENT_ALLOW_UPLOAD=0

# Delivery / vocal engagement analysis (wbudowane w audio_analysis)
# DELIVERY_ANALYSIS_STUB=0

# Voice re-synthesis (punktowe fragmenty; domyślnie wyłączone — tylko stub)
# VOICE_RESYNTHESIS_ENABLED=0
# VOICE_RESYNTHESIS_PROVIDER=stub
# VOICE_RESYNTHESIS_MAX_CHUNK_SEC=30
# VOICE_RESYNTHESIS_REQUIRE_CONSENT=1