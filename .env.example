OPENAI_API_KEY=sk-...

# Modele OpenAI (domyślnie gpt-5.4-nano / gpt-5.4-mini)
OPENAI_MODEL_NANO=gpt-5.4-nano
OPENAI_MODEL_MINI=gpt-5.4-mini
# OPENAI_MODEL_DIRECTOR=gpt-5.4-mini
# OPENAI_MODEL_CRITIC=gpt-5.4-mini
# OPENAI_MODEL_SFX_ENRICH=gpt-4o-mini-audio-preview
# OPENAI_MODEL_SFX_ENRICH_TEXT=gpt-5.4-nano

# OpenAI Whisper (transcribe step)
OPENAI_WHISPER_MODEL=whisper-1

# Opcjonalnie: ścieżki do ffmpeg
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Opcjonalnie: venv Pythona dla scene_detect / Qwen / Florence
# PYTHON_VENV=/path/to/venv
#
# Florence-2 (krok objects) jest WYMAGANY domyślnie — zainstaluj:
#   pip install -r python/requirements.txt
# Escape hatch bez detekcji: --no-objects lub --objects-stub

# TwelveLabs — domyślnie live gdy klucz ustawiony (stub: --twelvelabs-stub)
TWELVELABS_API_KEY=tlk_
TWELVELABS_INDEX_ID=6a47e322a050a53f8f63a3a6

# Globalny cache analizy per-clip między batchami (output/.cache/analysis).
# Ustaw DISABLE_GLOBAL_ANALYSIS_CACHE=1 aby wyłączyć (alternatywa: --no-global-cache).
# DISABLE_GLOBAL_ANALYSIS_CACHE=1

# Równoległość analizy per-clip (transcribe, audio, keyframes, twelvelabs)
# CLIP_CONCURRENCY=2

# Równoległość kroków GPU (vision, objects, face-detect)
# GPU_CONCURRENCY=1

# Równoległe wywołania segment directora (Super Director)
# SEGMENT_DIRECTOR_CONCURRENCY=3

# Review: domyślnie włącz --strict-review dla run/full (wymaga zatwierdzenia krytyka)

# Polityka LUT/korekcji koloru: off (domyślnie, iPhone SDR) | allow (włącz colorGrade z receptury)
# COLOR_GRADE_POLICY=off
# PIPELINE_STRICT_REVIEW=1

# Kling 3.0 — AI video hooks (krok ai_video; domyślnie wyłączone)
# Kup API: https://kling.ai/dev/pricing (Trial ~$9.80)
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# KLING_VIDEO_MODEL=kling-v2-6
# AI_VIDEO_STUB=1