OPENAI_API_KEY=sk-...

# Modele OpenAI (domyślnie gpt-5.5-nano / gpt-5.5-mini; fallback: gpt-4.1-nano / gpt-4.1-mini)
OPENAI_MODEL_NANO=gpt-5.5-nano
OPENAI_MODEL_MINI=gpt-5.5-mini

# Opcjonalnie: ścieżki do ffmpeg
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Opcjonalnie: venv Pythona dla scene_detect / Qwen / Florence
# PYTHON_VENV=/path/to/venv
#
# Florence-2 (krok objects) jest WYMAGANY domyślnie — zainstaluj:
#   pip install -r python/requirements.txt
# Escape hatch bez detekcji: --no-objects lub --objects-stub

TWELVELABS_API_KEY=tlk_