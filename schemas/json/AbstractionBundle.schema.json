{
  "$ref": "#/definitions/AbstractionBundle",
  "definitions": {
    "AbstractionBundle": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0"
        },
        "batchId": {
          "type": "string"
        },
        "L1": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sceneId": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "mood": {
                "type": "string"
              },
              "keyMoments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "brollPotential": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.5
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "visualQuality": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "default": "medium"
              },
              "stability": {
                "type": "string",
                "enum": [
                  "stable",
                  "shaky",
                  "unknown"
                ],
                "default": "unknown"
              },
              "isNarrationSource": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "sceneId",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "L2": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "segmentId": {
                "type": "string"
              },
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sceneIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              },
              "narrativeRole": {
                "type": "string",
                "enum": [
                  "setup",
                  "development",
                  "tension",
                  "breath",
                  "climax",
                  "payoff",
                  "resolution",
                  "callback"
                ]
              }
            },
            "required": [
              "segmentId",
              "startSec",
              "endSec",
              "sceneIds",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "L3": {
          "type": "object",
          "properties": {
            "sessionSummary": {
              "type": "string"
            },
            "narrativeArc": {
              "type": "string"
            },
            "recommendedFormats": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "16:9",
                  "9:16"
                ]
              },
              "default": [
                "16:9",
                "9:16"
              ]
            },
            "formatFit": {
              "type": "object",
              "properties": {
                "16:9": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "9:16": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            },
            "estimatedKeepRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hasSeparateNarration": {
              "type": "boolean",
              "default": false
            },
            "openLoops": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "loopId": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "cold_open",
                      "payoff_tease",
                      "callback"
                    ]
                  },
                  "setupSceneId": {
                    "type": "string"
                  },
                  "payoffSceneId": {
                    "type": "string"
                  },
                  "teaseText": {
                    "type": "string"
                  }
                },
                "required": [
                  "loopId",
                  "kind"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "hookCreativeBrief": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "type": "string",
                      "const": "contextual"
                    },
                    "narrativePromise": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contextualLink": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mustAvoid": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "default": [
                        "text overlays",
                        "logos",
                        "captions",
                        "spoilers",
                        "explicit payoff reveal"
                      ]
                    },
                    "visualTone": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unexpectedElement": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "strategy",
                    "narrativePromise",
                    "contextualLink"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "type": "string",
                      "const": "intentionally_unexpected"
                    },
                    "narrativePromise": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contextualLink": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mustAvoid": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "default": [
                        "text overlays",
                        "logos",
                        "captions",
                        "spoilers",
                        "explicit payoff reveal"
                      ]
                    },
                    "visualTone": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unexpectedElement": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "strategy",
                    "narrativePromise",
                    "contextualLink",
                    "unexpectedElement"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "editorialAssessment": {
              "type": "object",
              "properties": {
                "editabilityScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "strong",
                    "viable",
                    "salvageable",
                    "not_viable"
                  ]
                },
                "storyCoherenceScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "visualCoverageScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "dialogueValueScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "strengths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "weak_story",
                      "missing_context",
                      "weak_ending",
                      "insufficient_visuals",
                      "poor_dialogue_audio",
                      "excess_dead_air",
                      "repetitive_material",
                      "flat_delivery"
                    ]
                  },
                  "default": []
                },
                "recommendedSalvageModes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "voice_over",
                      "broll_montage",
                      "audio_enhancement",
                      "aggressive_trim",
                      "short_only",
                      "decline_output"
                    ]
                  },
                  "default": []
                },
                "reasoning": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "editabilityScore",
                "verdict",
                "reasoning"
              ],
              "additionalProperties": false
            },
            "deliveryAssessment": {
              "type": "object",
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "engaging",
                    "neutral",
                    "flat"
                  ]
                },
                "engagementScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "blockingForRetention": {
                  "type": "boolean",
                  "default": false
                },
                "recommendedRepairs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "editorial_pacing",
                      "dsp_polish",
                      "localized_emphasis",
                      "filler_cuts",
                      "voice_resynthesis"
                    ]
                  },
                  "default": []
                },
                "reasoning": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "verdict",
                "reasoning"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sessionSummary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "batchId",
        "L1",
        "L2",
        "L3"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
