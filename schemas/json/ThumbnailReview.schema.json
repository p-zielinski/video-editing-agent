{
  "$ref": "#/definitions/ThumbnailReview",
  "definitions": {
    "ThumbnailReview": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0"
        },
        "batchId": {
          "type": "string"
        },
        "approved": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "suggestion"
                ]
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "outputId": {
                "type": "string"
              },
              "variantId": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "summary": {
          "type": "string"
        },
        "revisedVariants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variantId": {
                "type": "string"
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "safe",
                  "controlled",
                  "risk"
                ]
              },
              "sourceRef": {
                "type": "object",
                "properties": {
                  "clipId": {
                    "type": "string"
                  },
                  "sceneId": {
                    "type": "string"
                  },
                  "timestampSec": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "clipId",
                  "sceneId",
                  "timestampSec"
                ],
                "additionalProperties": false
              },
              "headline": {
                "type": "string",
                "maxLength": 80
              },
              "titleVariant": {
                "type": "string",
                "maxLength": 120
              },
              "descriptionVariant": {
                "type": "string",
                "maxLength": 500
              },
              "style": {
                "type": "string",
                "enum": [
                  "frame_only",
                  "frame_plus_text",
                  "frame_text_accent"
                ]
              },
              "rationale": {
                "type": "string"
              },
              "renderedPath": {
                "type": "string"
              },
              "outputId": {
                "type": "string"
              }
            },
            "required": [
              "variantId",
              "strategy",
              "sourceRef",
              "headline",
              "titleVariant",
              "style",
              "rationale",
              "outputId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "batchId",
        "approved"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
