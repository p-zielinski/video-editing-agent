{
  "$ref": "#/definitions/WordIndex",
  "definitions": {
    "WordIndex": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "clipId": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "wordId": {
                "type": "string"
              },
              "word": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "isFiller": {
                "type": "boolean"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "normalizedWord": {
                "type": "string"
              },
              "isProfanity": {
                "type": "boolean"
              },
              "displayWord": {
                "type": "string"
              },
              "safetyClass": {
                "type": "string",
                "enum": [
                  "profanity",
                  "sensitive",
                  "protected_identity",
                  "hateful_attack"
                ]
              },
              "safetyAction": {
                "type": "string",
                "enum": [
                  "allow",
                  "review",
                  "bleep",
                  "mute",
                  "cut",
                  "mask"
                ]
              },
              "safetyReason": {
                "type": "string"
              },
              "safetyConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "wordId",
              "word",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "version",
        "clipId",
        "words",
        "durationSec"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
