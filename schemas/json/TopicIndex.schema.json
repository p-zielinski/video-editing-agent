{
  "$ref": "#/definitions/TopicIndex",
  "definitions": {
    "TopicIndex": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "1.0",
            "2.0"
          ]
        },
        "batchId": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topicId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "wordIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeRange": {
                "type": "object",
                "properties": {
                  "clipId": {
                    "type": "string"
                  },
                  "startSec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "clipId",
                  "startSec",
                  "endSec"
                ],
                "additionalProperties": false
              },
              "matchingScenes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sceneId": {
                      "type": "string"
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "sceneId",
                    "score"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "topicId",
              "label",
              "wordIds",
              "timeRange",
              "matchingScenes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "batchId",
        "topics"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
