{
  "$ref": "#/definitions/EditRecipe",
  "definitions": {
    "EditRecipe": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0"
        },
        "batchId": {
          "type": "string"
        },
        "batchContext": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string"
            },
            "dayLabel": {
              "type": "string"
            },
            "challengeDay": {
              "type": "string"
            },
            "targetPlatforms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "notes": {
              "type": "string"
            },
            "qualityOverQuantity": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "outputId": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "16:9",
                  "9:16"
                ]
              },
              "targetDurationSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "title": {
                "type": "string"
              },
              "synopsis": {
                "type": "string"
              },
              "timeline": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "segmentId": {
                      "type": "string"
                    },
                    "sourceRef": {
                      "type": "object",
                      "properties": {
                        "clipId": {
                          "type": "string"
                        },
                        "sceneId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "clipId",
                        "sceneId"
                      ],
                      "additionalProperties": false
                    },
                    "videoInSec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "videoOutSec": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "audioPolicy": {
                      "type": "string",
                      "enum": [
                        "source",
                        "from_prev",
                        "from_next",
                        "external",
                        "mute"
                      ],
                      "default": "source"
                    },
                    "audioOffsetSec": {
                      "type": "number",
                      "default": 0
                    },
                    "cuts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "startWordId": {
                            "type": "string"
                          },
                          "endWordId": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "keepIfStoryCritical": {
                            "type": "boolean",
                            "default": false
                          }
                        },
                        "required": [
                          "startWordId",
                          "endWordId",
                          "reason"
                        ],
                        "additionalProperties": false
                      },
                      "default": []
                    },
                    "subtitles": {
                      "type": "object",
                      "properties": {
                        "policy": {
                          "type": "string",
                          "enum": [
                            "word_by_word",
                            "sentence",
                            "custom",
                            "none"
                          ]
                        },
                        "customText": {
                          "type": "string"
                        },
                        "style": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "policy"
                      ],
                      "additionalProperties": false
                    },
                    "textOverlays": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "startSec": {
                            "type": "number",
                            "minimum": 0
                          },
                          "endSec": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "position": {
                            "type": "string",
                            "enum": [
                              "top",
                              "center",
                              "bottom",
                              "custom"
                            ],
                            "default": "bottom"
                          },
                          "safeArea": {
                            "type": "string",
                            "enum": [
                              "16:9",
                              "9:16"
                            ]
                          }
                        },
                        "required": [
                          "text",
                          "startSec",
                          "endSec"
                        ],
                        "additionalProperties": false
                      },
                      "default": []
                    },
                    "videoTransform": {
                      "type": "object",
                      "properties": {
                        "crop": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "w": {
                              "type": "number"
                            },
                            "h": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "x",
                            "y",
                            "w",
                            "h"
                          ],
                          "additionalProperties": false
                        },
                        "reframe": {
                          "type": "string",
                          "enum": [
                            "center",
                            "face",
                            "subject"
                          ]
                        },
                        "speed": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "default": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "segmentId",
                    "sourceRef",
                    "videoInSec",
                    "videoOutSec"
                  ],
                  "additionalProperties": false
                }
              },
              "chapterMarkers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "startSec": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "title",
                    "startSec"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "outputId",
              "format",
              "title",
              "timeline"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sceneId": {
                "type": "string"
              },
              "clipId": {
                "type": "string"
              },
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "reason": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.8
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "sceneUsageRegistry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sceneId": {
                "type": "string"
              },
              "outputId": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "16:9",
                  "9:16"
                ]
              }
            },
            "required": [
              "sceneId",
              "outputId",
              "format"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "needsHumanReview": {
          "type": "boolean",
          "default": false
        },
        "reviewNotes": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "batchId",
        "batchContext",
        "outputs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
