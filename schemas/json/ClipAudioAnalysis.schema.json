{
  "$ref": "#/definitions/ClipAudioAnalysis",
  "definitions": {
    "ClipAudioAnalysis": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "clipId": {
          "type": "string"
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "voiceLufs": {
          "type": [
            "number",
            "null"
          ]
        },
        "energyCurve": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rmsDb": {
                "type": "number"
              }
            },
            "required": [
              "startSec",
              "endSec",
              "rmsDb"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "silenceGaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "durationSec": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "startSec",
              "endSec",
              "durationSec"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timeSec": {
                "type": "number",
                "minimum": 0
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "timeSec",
              "strength"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "musicBedRecommendation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mood": {
                  "type": "string"
                },
                "trackId": {
                  "type": "string"
                },
                "bpm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "mood"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "cutSuggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timeSec": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "timeSec",
              "reason"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "analysisMode": {
          "type": "string",
          "enum": [
            "librosa",
            "ffmpeg",
            "ffmpeg_astats",
            "stub",
            "speech_onsets",
            "musical_beats",
            "musical_onsets"
          ]
        },
        "estimatedBpm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "audioEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "label": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "editorialTag": {
                "type": "string"
              },
              "category": {
                "type": "string"
              }
            },
            "required": [
              "startSec",
              "endSec",
              "label",
              "score"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "editorialTags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "peakScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "totalDurationSec": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "tag",
              "count",
              "peakScore",
              "totalDurationSec"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "eventDetectionMode": {
          "type": "string",
          "enum": [
            "panns",
            "stub",
            "none"
          ]
        },
        "audioQuality": {
          "type": "object",
          "properties": {
            "assessmentVersion": {
              "type": "string",
              "const": "1.0"
            },
            "mode": {
              "type": "string",
              "enum": [
                "heuristic",
                "ml",
                "hybrid",
                "stub"
              ]
            },
            "hasSpeech": {
              "type": "boolean"
            },
            "speechPresenceRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "estimatedSnrDb": {
              "type": [
                "number",
                "null"
              ]
            },
            "noiseFloorDbfs": {
              "type": [
                "number",
                "null"
              ]
            },
            "clippingRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "windScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "humScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "speechClarityScore": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "qualityScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grade": {
              "type": "string",
              "enum": [
                "good",
                "usable",
                "poor",
                "unusable"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "enhancementRecommended": {
              "type": "boolean"
            },
            "enhancementCandidateId": {
              "type": "string"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "required": [
            "assessmentVersion",
            "mode",
            "hasSpeech",
            "qualityScore",
            "grade",
            "enhancementRecommended"
          ],
          "additionalProperties": false
        },
        "deliveryAnalysis": {
          "type": "object",
          "properties": {
            "assessmentVersion": {
              "type": "string",
              "const": "1.0"
            },
            "mode": {
              "type": "string",
              "enum": [
                "heuristic",
                "hybrid",
                "stub"
              ]
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startSec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "f0SemitoneSd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "loudnessModulation": {
                    "type": "number",
                    "minimum": 0
                  },
                  "wpm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "pauseRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "voicedRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "engagementScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "issues": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "flat_pitch",
                        "steady_energy",
                        "steady_pace",
                        "high_fillers"
                      ]
                    },
                    "default": []
                  }
                },
                "required": [
                  "startSec",
                  "endSec",
                  "engagementScore"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "clipSummary": {
              "type": "object",
              "properties": {
                "engagementGrade": {
                  "type": "string",
                  "enum": [
                    "engaging",
                    "neutral",
                    "flat"
                  ]
                },
                "engagementScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "dominantIssues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "flatWindowCount": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "flatDeliveryWindows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startSec": {
                        "type": "number",
                        "minimum": 0
                      },
                      "endSec": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "engagementScore": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "issues": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "flat_pitch",
                            "steady_energy",
                            "steady_pace",
                            "high_fillers"
                          ]
                        },
                        "default": []
                      }
                    },
                    "required": [
                      "startSec",
                      "endSec",
                      "engagementScore"
                    ],
                    "additionalProperties": false
                  },
                  "default": []
                }
              },
              "required": [
                "engagementGrade",
                "engagementScore"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "assessmentVersion",
            "mode",
            "clipSummary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "clipId",
        "durationSec",
        "voiceLufs",
        "analysisMode"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
